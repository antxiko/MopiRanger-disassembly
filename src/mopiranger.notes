C 0x4238 con 48 cuadros
L 0x423c espera_del_fin_de_zona
C 0x423c la cuenta atras
C 0x4240 hasta cero no se sigue
C 0x4241 mira si quedan vidas
C 0x4244 el sonido de zona superada
C 0x4248 o el de perder
L 0x4250 escena_de_perder
B 0x4250 Decide si la partida sigue o se acaba: con vidas, a repetir zona; sin vidas, GAME OVER.
C 0x4250 quedan vidas?
C 0x4253 si no, se acabo
C 0x4255 las vidas
C 0x4259 a cero, fin de partida
L 0x425b vuelve_a_la_zona
C 0x425b estado 4
L 0x425d espera_treinta_y_dos_cuadros
C 0x425d 32 cuadros
L 0x425f fija_estado_y_espera
C 0x425f el estado nuevo
C 0x4263 y su espera
L 0x4268 pinta_el_game_over
C 0x4268 espera a que acabe la entrada
C 0x426c el sonido de fin de partida
C 0x4271 el rotulo GAME OVER
