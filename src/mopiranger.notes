L 0x41fd espera_treinta_y_dos
C 0x41fd los 32 cuadros de siempre
L 0x4202 pasa_a_la_escena_siguiente
C 0x4202 el estado del juego
C 0x4205 uno mas
L 0x4206 reinicia_el_subestado
C 0x4206 el subestado vuelve a cero al cambiar de escena
