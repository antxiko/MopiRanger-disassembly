C 0x595d la de arriba estaba libre?
C 0x595f abajo
C 0x5963 o arriba
L 0x5964 sale_por_la_unica_vertical
C 0x5964 la direccion elegida
L 0x5969 elige_la_vertical_mas_cerca
C 0x5969 la distancia al objetivo en X
C 0x596b si el objetivo esta a la derecha
C 0x596d se va a la derecha
L 0x5973 sale_a_la_izquierda
C 0x5973 y si no, a la izquierda
L 0x5979 rodea_desde_la_derecha
